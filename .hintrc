{
  "extends": [
    "development"
  ],
  "hints": {
    "meta-viewport": "off",
    "compat-api/html": [
      "default",
      {
        "ignore": [
          "meta[name=theme-color]",
          "input[autocapitalize]"
        ]
      }
    ],
    "apple-touch-icons": "off",
    "compat-api/css": [
      "default",
      {
        "ignore": [
          "-webkit-overflow-scrolling",
          "overscroll-behavior",
          "overscroll-behavior: none",
          "-webkit-user-drag",
          "scrollbar-width",
          "scrollbar-width: none"
        ]
      }
    ],
    "axe/forms": [
      "default",
      {
        "label": "off"
      }
    ],
    "no-protocol-relative-urls": "off"
  }
}